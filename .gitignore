# Build output — nunca versionar binário (o git com core.autocrlf corrompe
# a DLL na ida/volta: SizeOfImage 611840 virava 741376 no crash log).
# Fingerprint por sessão: SHA256 + injector_state.txt (size-mtime), nunca git.
build/
*.obj
*.ipdb
*.tlog
*.dll.old
*.iobj
*.pdb

# Autosave vazio gerado pelo Cheat Engine durante diagnosticos
ExceptionAutoSave_*.ct

# Local credentials, tool settings and editor caches
.env
.env.*
!.env.example
opencode.json
.vs/
__pycache__/
*.pyc

# Distribution artifacts and private signing material
dist/
*.zb2license
*.pfx
*.p12
*.key
*.dpapi
loader-private/
*.zb2station
*.zb2issuer
